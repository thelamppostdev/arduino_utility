{
  "name": "arduino-utility",
  "version": "1.0.0",
  "devDependencies": {
    "@types/node": "^20.1.4",
    "@types/yargs": "^17.0.24",
    "pkg": "^5.8.1",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@aws-sdk/client-amplify": "^3.687.0",
    "serialport": "^13.0.0",
    "yargs": "^17.7.2"
  },
  "bin": {
    "cli": "./build/cli.js"
  },
  "scripts": {
    "build": "tsc && cp -r lib/scripts build/",
    "package": "pkg . --targets node14-macos-x64 --output cli"
  },
  "pkg": {
    "scripts": "build/**/*.js",
    "assets": "build/scripts/**/*"
  }
}
